#Largest of 3nums
DECLARE
    n1 int := &a;
    n2 int := &b;
    n3 int := &c;
BEGIN
    IF n1 >= n2 AND n1 >= n3 THEN
        DBMS_OUTPUT.PUT_LINE('Largest Number = ' || n1);
    ELSIF n2 >= n1 AND n2 >= n3 THEN
        DBMS_OUTPUT.PUT_LINE('Largest Number = ' || n2);
    ELSE
        DBMS_OUTPUT.PUT_LINE('Largest Number = ' || n3);
    END IF;
END;

Output:
n1=2
n2=7
n3=1
Largest Number=7

#Multiplication
DECLARE
    num NUMBER := &n;
BEGIN
    IF MOD(num, 2) = 0 THEN
        DBMS_OUTPUT.PUT_LINE(num || ' is Even Number');
    ELSE
        DBMS_OUTPUT.PUT_LINE(num || ' is Odd Number');
    END IF;
END;

OUTPUT:
num=5
5 is Odd Number

DECLARE
    num NUMBER := &n;
BEGIN
    FOR i IN 1..10 LOOP
        DBMS_OUTPUT.PUT_LINE(num || ' x ' || i || ' = ' || (num * i));
    END LOOP;
END;

OUTPUT:
